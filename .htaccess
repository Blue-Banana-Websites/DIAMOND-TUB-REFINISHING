# ----------------------------------------------------------------------
# Canonical host: force non-www (matches sitemap.xml + robots.txt)
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} ^www\.diamondtubrefinishing\.ca$ [NC]
  RewriteRule ^ https://diamondtubrefinishing.ca%{REQUEST_URI} [R=301,L]
</IfModule>


# ----------------------------------------------------------------------
# Force HTTPS
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>


# ----------------------------------------------------------------------
# Block hidden files and directories
# (excludes /.well-known/ so Let's Encrypt / ACME HTTP validation still works)
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule "(^|/)\." - [F]
</IfModule>

<Files ".htaccess">
  Require all denied
</Files>


# ----------------------------------------------------------------------
# CORS for images and fonts
# ----------------------------------------------------------------------

<IfModule mod_headers.c>
  <FilesMatch "\.(gif|jpe?g|png|webp|svg|ico)$">
  Header set Cache-Control "public, max-age=31536000"
</FilesMatch>

  <FilesMatch "\.(eot|otf|ttf|ttc|woff|woff2)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>


# ----------------------------------------------------------------------
# Compression
# ----------------------------------------------------------------------

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/ld+json application/xml image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/ld+json application/xml image/svg+xml font/ttf font/otf font/woff font/woff2
</IfModule>

<IfModule mod_mime.c>
  AddEncoding gzip svgz
</IfModule>


# ----------------------------------------------------------------------
# Expires headers
# ----------------------------------------------------------------------

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  ExpiresByType text/html "access plus 0 seconds"

  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"

  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/ld+json "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
</IfModule>


# ----------------------------------------------------------------------
# Cache-Control headers
# ----------------------------------------------------------------------

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff|woff2|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  <FilesMatch "\.(gif|jpe?g|png|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  <FilesMatch "\.(html|json|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>


# ----------------------------------------------------------------------
# Disable ETags
# ----------------------------------------------------------------------

<IfModule mod_headers.c>
  Header unset ETag
</IfModule>

FileETag None


# ----------------------------------------------------------------------
# Security headers
# ----------------------------------------------------------------------

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Safer HSTS for launch. Add includeSubDomains/preload only when certain.
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
